{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shenqing.local/mobile/spaces.schema.json",
  "title": "深清空间与当前会话（/spaces）",
  "type": "object",
  "required": [
    "schema",
    "spaces",
    "active"
  ],
  "properties": {
    "schema": {
      "const": "shenqing.spaces/v1"
    },
    "spaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "minutes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "minutes": {
            "type": "number",
            "minimum": 1
          },
          "tier": {
            "enum": [
              "light",
              "cover",
              "deep",
              "sleep"
            ]
          },
          "atmosphere": {
            "type": "string"
          },
          "allowed_apps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "super": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "active": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "spaceId",
            "name",
            "remainingSeconds",
            "totalSeconds"
          ],
          "properties": {
            "spaceId": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "tier": {
              "enum": [
                "light",
                "cover",
                "deep",
                "sleep"
              ]
            },
            "remainingSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "totalSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "paused": {
              "type": "boolean"
            },
            "canPause": {
              "type": "boolean"
            },
            "locked": {
              "type": "boolean"
            },
            "startedAt": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      ]
    }
  },
  "additionalProperties": true
}
