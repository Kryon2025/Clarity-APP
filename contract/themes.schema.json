{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shenqing.local/mobile/themes.schema.json",
  "title": "深清主题包列表（/themes）",
  "type": "object",
  "required": [
    "schema",
    "themes"
  ],
  "properties": {
    "schema": {
      "const": "shenqing.themes/v1"
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "name": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "builtIn": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
