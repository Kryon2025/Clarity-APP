{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shenqing.local/mobile/chat.schema.json",
  "title": "深清 AI 对话（/chat 请求与响应）",
  "$defs": {
    "message": {
      "type": "object",
      "required": [
        "role",
        "content"
      ],
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "reasoning": {
          "type": "string"
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    }
  },
  "oneOf": [
    {
      "title": "请求",
      "type": "object",
      "required": [
        "schema",
        "messages"
      ],
      "properties": {
        "schema": {
          "const": "shenqing.chat/v1"
        },
        "conversationId": {
          "type": "string"
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "stream": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    {
      "title": "响应",
      "type": "object",
      "required": [
        "schema",
        "ok"
      ],
      "properties": {
        "schema": {
          "const": "shenqing.chat/v1"
        },
        "ok": {
          "const": true
        },
        "conversationId": {
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/message"
        },
        "usage": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  ]
}
