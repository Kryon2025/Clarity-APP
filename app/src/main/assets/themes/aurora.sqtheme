{
  "schema": "shenqing.theme-pack/v1",
  "id": "com.shenqing.theme.aurora",
  "name": "极光",
  "author": "深清示例",
  "version": "1.0.0",
  "description": "深色极光：紫青强调色，适合夜间专注。",
  "base": "solid",
  "modes": {
    "solid": {
      "colors": {
        "bgTop": "#06121F",
        "bgMid": "#0A1A2A",
        "bgBottom": "#0B2233",
        "bgStart": "#0A1A2A",
        "bgCenter": "#0A1A2A",
        "accent": "#8B5CF6",
        "accentSoft": "#22D3EE",
        "accentDeep": "#5B21B6",
        "cardBg": "#0D1A2B",
        "cardBgAlt": "#10243A",
        "textPrimary": "#F2F7FF",
        "textSecondary": "#A9C6D2",
        "textTertiary": "#6E8C99",
        "gradA": "#A78BFA",
        "gradB": "#8B5CF6",
        "gradC": "#22D3EE",
        "gradDeep": "#4C1D95",
        "onAccent": "#0B0618"
      }
    }
  },
  "desktop": {
    "hint": "用 tools/theme_pack.py 校验并生成 QML 预览；宿主动态主题加载尚未接入。"
  },
  "palette": {
    "bgTop": "#06121F",
    "bgMid": "#0A1A2A",
    "bgBottom": "#0B2233",
    "accent": "#8B5CF6",
    "cardBg": "#0D1A2B",
    "textPrimary": "#F2F7FF"
  },
  "platforms": [
    "desktop",
    "mobile"
  ]
}
